# ---- ビルド段階：Reactアプリを静的ファイルにビルド ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build
# → /app/dist に静的ファイルが出力される

# ---- 配信段階：nginxで静的配信＋/apiをbackendへ中継 ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
