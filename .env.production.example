# 本番環境の環境変数テンプレート。
# コピーして .env を作り、値を本番用に変更する:
#   cp .env.production.example .env
# ※ .env は git 管理しないこと（.gitignore 済み）

# PostgreSQL
POSTGRES_USER=minijira
POSTGRES_PASSWORD=ここを強力なパスワードに変更
POSTGRES_DB=minijira

# アプリからのDB接続文字列（上のUSER/PASSWORD/DBと揃える）
DATABASE_URL=postgresql://minijira:ここを強力なパスワードに変更@db:5432/minijira?schema=public

NODE_ENV=production

# 初期管理者（seed-prod.ts で作成される）
ADMIN_NAME=管理者
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ここを強力な管理者パスワードに変更
